generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transportadora {
  id                     String                  @id @default(cuid())
  nome                   String
  cnpj                   String?
  codigoSlug             String                  @unique
  ativo                  Boolean                 @default(true)
  origem                 String                  @default("real")
  tokenPublicoFormulario String                  @unique
  emailsDestinatarios    String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  submissions            DailyReportSubmission[]
  automationLogs         AutomationLog[]
  qualityLogs            SubmissionQualityLog[]
  users                  AppUser[]
  pedidos                Pedido[]
  pedidoChangeAttempts   PedidoFieldChangeAttempt[]
  aliases                TransportadoraAlias[]

  @@map("transportadoras")
}

model AppUser {
  id                 String          @id @default(cuid())
  authUserId         String?         @unique @db.Uuid
  username           String?         @unique
  email              String          @unique
  nome               String
  passwordHash       String?
  passwordMustChange Boolean         @default(false)
  credentialSentAt   DateTime?
  credentialSentBy   String?
  role               String          @default("carrier_operator")
  ativo              Boolean         @default(true)
  transportadoraId   String?
  lastLoginAt        DateTime?
  passwordUpdatedAt  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  transportadora     Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)
  sessions           AppSession[]
  qualityLogs        SubmissionQualityLog[]
  pedidoChangeAttempts PedidoFieldChangeAttempt[]

  @@index([transportadoraId])
  @@index([role])
  @@map("app_users")
}

model AppSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("app_sessions")
}

model DailyReportSubmission {
  id                       String                         @id @default(cuid())
  transportadoraId         String
  dataReport               DateTime
  dataResultadoDiaAnterior DateTime
  dataPreviaDiaAtual       DateTime
  status                   String                         @default("draft")
  submittedAt              DateTime?
  submittedByName          String?
  submittedByEmail         String?
  observacoes              String?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  transportadora           Transportadora                 @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)
  previousDayMetrics       DailyPreviousDayMetrics?
  currentDayPreviewMetrics DailyCurrentDayPreviewMetrics?
  ufMetrics                PreviousDayUFMetric[]

  @@unique([transportadoraId, dataReport])
  @@index([transportadoraId, dataReport])
  @@map("report_submissions")
}

model DailyPreviousDayMetrics {
  id                      String                @id @default(cuid())
  submissionId            String                @unique
  totalPedidos            Int
  totalEntregue           Int
  totalEmAberto           Int
  totalTentativaInsucesso Int
  totalDevolucao          Int
  totalCancelado          Int
  totalNoPrazo            Int
  totalForaDoPrazo        Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  submission              DailyReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("previous_day_metrics")
}

model DailyCurrentDayPreviewMetrics {
  id                      String                @id @default(cuid())
  submissionId            String                @unique
  totalPedidos            Int
  totalFinalizado         Int
  totalEmAberto           Int
  totalEntregue           Int
  totalTentativaInsucesso Int
  totalDevolucao          Int
  totalCancelado          Int
  finalizadosNoPrazo      Int
  finalizadosForaDoPrazo  Int
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  submission              DailyReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("current_day_preview_metrics")
}

model PreviousDayUFMetric {
  id            String                @id @default(cuid())
  submissionId  String
  uf            String
  dentroDoPrazo Int
  foraDoPrazo   Int
  total         Int
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  submission    DailyReportSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, uf])
  @@map("previous_day_uf_metrics")
}

model AutomationLog {
  id               String          @id @default(cuid())
  transportadoraId String?
  dataReport       DateTime
  tipo             String
  status           String
  mensagem         String
  payload          String?
  createdAt        DateTime        @default(now())
  transportadora   Transportadora? @relation(fields: [transportadoraId], references: [id], onDelete: SetNull)

  @@index([transportadoraId, dataReport])
  @@map("automation_logs")
}

model SubmissionQualityLog {
  id               String          @id @default(cuid())
  transportadoraId String
  userId           String?
  dataReport       DateTime
  action           String
  status           String          @default("blocked")
  reasons          String
  payloadSummary   String?
  createdAt        DateTime        @default(now())
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)
  user             AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([transportadoraId, dataReport])
  @@index([userId])
  @@index([createdAt])
  @@map("submission_quality_logs")
}

// Pedido individual da base Forms Transp (carga diária Intelipost + resposta operacional
// da transportadora). Chave única de negócio: `pedido`.
model Pedido {
  id String @id @default(cuid())

  pedido String @unique

  // ---- Campos de origem (upsert diário via API da Intelipost) ----
  nomeDestinatario   String
  canalVendas        String
  cidadeDestinatario String
  uf                 String
  cepDestinatario    String
  pedidoDeVenda      String
  codigoRastreio     String?
  notaFiscal         String?
  metodoEnvio        String?
  transportadoraId   String
  transportadora     Transportadora @relation(fields: [transportadoraId], references: [id])
  valorNota          Decimal?       @db.Decimal(12, 2)
  pesoFisico         Decimal?       @db.Decimal(10, 3)
  chaveNota          String?

  // Data Criação da Intelipost. Define a janela dos 45 dias da Base Completa.
  // NÃO confundir com `createdAt` (data em que o registro foi criado no nosso banco).
  dataCriacaoPedido DateTime

  // Data Entrega da Intelipost. Não é editável pela transportadora.
  // Determina se o pedido está finalizado (IS NOT NULL = finalizado, some da
  // visão da transportadora no ciclo seguinte; a Base Completa continua trazendo
  // enquanto dataCriacaoPedido estiver dentro da janela de 45 dias).
  dataEntregaOrigem DateTime?

  // Previsões vindas da Intelipost. Campos de origem/protegidos; não
  // reutilizar `dataPrevisao`, que é operacional e preenchida pela transportadora.
  previsaoEntregaClienteOrigem        DateTime?
  previsaoEntregaTransportadoraOrigem DateTime?

  // Campos adicionais de origem Intelipost usados nas regras e KPIs.
  // Atualizados pela carga diaria e protegidos contra edicao.
  dataDespacho                           DateTime?
  previsaoEntregaTransportadoraOriginal DateTime?
  microStatus                            String?
  statusTransportador                    String?

  origemAtualizadoEm DateTime @default(now())

  // ---- Campos operacionais (preenchidos pela transportadora, upload de devolução) ----
  dataColetaProcessamento DateTime?
  dataPrevisao            DateTime?
  prazoEntregaDiasUteis   Int?
  dataEntrega             DateTime? // DATA DE ENTREGA operacional, preenchida pela transportadora
  statusAtual             String?
  ocorrencia              String?
  motivoDevolucao         String?
  slaStatus               String?
  justificativaAtraso     String?
  novaDataPrevisao        DateTime?
  dataResolucaoDevolucao  DateTime?

  operacionalAtualizadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  changeAttempts PedidoFieldChangeAttempt[]

  @@index([transportadoraId, dataEntregaOrigem])
  @@index([dataCriacaoPedido])
  @@map("pedidos")
}

// Item 7: registro de tentativa de alterar um campo operacional que já havia
// sido preenchido anteriormente. A alteração é bloqueada (status = "blocked");
// o valor salvo em Pedido é preservado.
model PedidoFieldChangeAttempt {
  id String @id @default(cuid())

  pedidoId         String
  pedido           Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  transportadoraId String
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id])
  userId           String?
  user             AppUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  campo        String
  valorAtual   String?
  valorTentado String?
  status       String @default("blocked")

  createdAt DateTime @default(now())

  @@index([pedidoId])
  @@index([transportadoraId, createdAt])
  @@map("pedido_field_change_attempts")
}

// DE/PARA de nomes que a Intelipost (ou outra origem futura) pode usar
// para uma transportadora já cadastrada. `Transportadora.nome` continua
// sendo o cadastro oficial - isto é só um apelido adicional que resolve
// para ela. `aliasNormalizado` é único no banco: um mesmo texto (ignorando
// caixa/acento) nunca pode apontar para duas transportadoras diferentes.
model TransportadoraAlias {
  id String @id @default(cuid())

  transportadoraId String
  transportadora   Transportadora @relation(fields: [transportadoraId], references: [id], onDelete: Cascade)

  alias            String // como a origem manda, ex.: "Diálogo Logística" (guardado para exibição/auditoria)
  aliasNormalizado String @unique // normalizado (maiúsculo, sem acento) - usado no matching

  createdAt DateTime @default(now())

  @@index([transportadoraId])
  @@map("transportadora_aliases")
}
